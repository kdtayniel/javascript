let leftResetTimer = null;
let rightResetTimer = null;
let keyTimestamps = [];

function updateKPS() {
    const now = Date.now();
    keyTimestamps = keyTimestamps.filter(time => now - time < 1000);
    kpsDisplay.textContent = `${keyTimestamps.length.toFixed(1)} KPS`;
}

if (window.kpsInterval) clearInterval(window.kpsInterval);
window.kpsInterval = setInterval(updateKPS, 100);

// 키 press 및 고양이 반응
window.addEventListener('keydown', function(event) {
    if (event.repeat) return; // 오토 리피트 방지
   
    keyTimestamps.push(Date.now());
    updateKPS();
   
    let keyName = event.key;
    if (keyName === " ") keyName = "Space";
    keyDisplay.textContent = `누른 키: [ ${keyName.toUpperCase()} ]`;
   
    const code = event.code;
    const keyData = keyElementsMap[code];
   
    if (keyData) {
        keyData.el.style.background = '#51cf66';
        keyData.el.style.color = '#1e1e1e';
        keyData.el.style.transform = 'translateY(1px)';
        keyData.el.style.borderBottomWidth = '1px';

        if (keyData.side === 'left') {
            clearTimeout(leftResetTimer);
            leftPaw.style.transform = 'rotate(0deg) translateY(0px)';
            leftResetTimer = setTimeout(() => {
                leftPaw.style.transform = 'rotate(15deg) translateY(-20px)';
            }, 120);
        } else if (keyData.side === 'right') {
            clearTimeout(rightResetTimer);
            rightPaw.style.transform = 'rotate(0deg) translateY(0px)';
            rightResetTimer = setTimeout(() => {
                rightPaw.style.transform = 'rotate(-15deg) translateY(-20px)';
            }, 120);
        } else if (keyData.side === 'both') {
            clearTimeout(leftResetTimer);
            clearTimeout(rightResetTimer);
            leftPaw.style.transform = 'rotate(0deg) translateY(0px)';
            rightPaw.style.transform = 'rotate(0deg) translateY(0px)';
            leftResetTimer = setTimeout(() => {
                leftPaw.style.transform = 'rotate(15deg) translateY(-20px)';
                rightPaw.style.transform = 'rotate(-15deg) translateY(-20px)';
            }, 120);
        }
    }
   
    setTimeout(() => {
        keyDisplay.textContent = "누른 키: [ 대기 ]";
    }, 120);
}, true);

window.addEventListener('keyup', function(event) {
    const code = event.code;
    const keyData = keyElementsMap[code];
    if (keyData) {
        keyData.el.style.background = '#2d2d2d';
        keyData.el.style.color = '#fff';
        keyData.el.style.transform = 'translateY(0)';
        keyData.el.style.borderBottomWidth = '2px';
    }
}, true);

