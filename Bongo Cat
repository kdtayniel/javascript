            <line x1="0" y1="140" x2="400" y2="140" stroke="black" stroke-width="6"/>
           
            <!-- 회색 노트북 패드 -->
            <rect x="25" y="115" width="105" height="55" rx="6" fill="#d4d4d8" stroke="black" stroke-width="3"/>
           
            <!-- 180도 회전된 마우스 그림 -->
            <g id="mouse-obj" style="transition: 0.05s; transform-origin: 70px 133px;">
                <g transform="rotate(180, 70, 133)">
                    <rect x="55" y="110" width="30" height="46" rx="15" fill="#f4f4f5" stroke="black" stroke-width="3"/>
                    <line x1="70" y1="110" x2="70" y2="130" stroke="black" stroke-width="2"/>
                </g>
            </g>
           
            <!-- 고양이 전체 그룹 (오른쪽으로 15px 이동) -->
            <g transform="translate(15, 0)">
                <!-- 왼쪽 삼각형 귀 -->
                <path d="M 153 52 L 140 16 L 175 48 Z" fill="white" stroke="black" stroke-width="6" stroke-linejoin="round"/>
               
                <!-- 오른쪽 삼각형 귀 -->
                <path d="M 247 52 L 260 16 L 225 48 Z" fill="white" stroke="black" stroke-width="6" stroke-linejoin="round"/>
               
                <!-- 고양이 머리 본체 (더 작고 아담한 반원형 돔 형태) -->
                <path d="M 150 140 L 150 90 A 50 50 0 0 1 250 90 L 250 140 Z" fill="white" stroke="black" stroke-width="6" stroke-linejoin="round"/>
               
                <!-- 눈과 w 모양 입 -->
                <circle id="left-eye" cx="178" cy="110" r="5" fill="black"/>
                <circle id="right-eye" cx="222" cy="110" r="5" fill="black"/>
                <path id="cat-mouth" d="M 195 118 Q 200 123 205 118" fill="none" stroke="black" stroke-width="4" stroke-linecap="round"/>

                <!-- 타자칠 때 나타나는 앞발 -->
                <ellipse id="paw-left" cx="145" cy="132" rx="12" ry="11" fill="white" stroke="black" stroke-width="4" style="display:none;" />
                <ellipse id="paw-right" cx="255" cy="132" rx="12" ry="11" fill="white" stroke="black" stroke-width="4" style="display:none;" />
            </g>
        </svg>
    `;

    // 정보 표시 바
    const infoBox = document.createElement('div');
    infoBox.style.display = 'flex';
    infoBox.style.justifyContent = 'space-between';
    infoBox.style.alignItems = 'center';
    infoBox.style.fontSize = '11px';
    infoBox.style.fontWeight = 'bold';
    infoBox.style.padding = '0 4px';
    container.appendChild(infoBox);

    const keyDisplay = document.createElement('div');
    keyDisplay.style.color = '#ffb8b8';
    keyDisplay.textContent = '입력: [ 대기 ]';
    infoBox.appendChild(keyDisplay);

    const mouseClickDisplay = document.createElement('div');
    mouseClickDisplay.style.color = '#38bdf8';
    mouseClickDisplay.textContent = '마우스: 0회';
    infoBox.appendChild(mouseClickDisplay);

    const countDisplay = document.createElement('div');
    countDisplay.style.color = '#74c0fc';
    countDisplay.textContent = '총 타수: 0';
    infoBox.appendChild(countDisplay);

    const kpsDisplay = document.createElement('div');
    kpsDisplay.style.color = '#51cf66';
    kpsDisplay.textContent = '0.0 KPS';
    infoBox.appendChild(kpsDisplay);

    // 61키 가상 키보드 영역
    const kbContainer = document.createElement('div');
    kbContainer.style.display = 'flex';
    kbContainer.style.flexDirection = 'column';
    kbContainer.style.gap = '3px';
    container.appendChild(kbContainer);

    const keyboardRows = [
        [
            { label: '`', code: 'Backquote', w: '24px' },
            { label: '1', code: 'Digit1', w: '24px' }, { label: '2', code: 'Digit2', w: '24px' }, { label: '3', code: 'Digit3', w: '24px' },
            { label: '4', code: 'Digit4', w: '24px' }, { label: '5', code: 'Digit5', w: '24px' }, { label: '6', code: 'Digit6', w: '24px' },
            { label: '7', code: 'Digit7', w: '24px' }, { label: '8', code: 'Digit8', w: '24px' }, { label: '9', code: 'Digit9', w: '24px' },
            { label: '0', code: 'Digit0', w: '24px' }, { label: '-', code: 'Minus', w: '24px' }, { label: '=', code: 'Equal', w: '24px' },
            { label: 'Bksp', code: 'Backspace', w: '44px' }
        ],
        [
            { label: 'Tab', code: 'Tab', w: '38px' },
            { label: 'Q', code: 'KeyQ', w: '24px' }, { label: 'W', code: 'KeyW', w: '24px' }, { label: 'E', code: 'KeyE', w: '24px' },
            { label: 'R', code: 'KeyR', w: '24px' }, { label: 'T', code: 'KeyT', w: '24px' }, { label: 'Y', code: 'KeyY', w: '24px' },
            { label: 'U', code: 'KeyU', w: '24px' }, { label: 'I', code: 'KeyI', w: '24px' }, { label: 'O', code: 'KeyO', w: '24px' },
            { label: 'P', code: 'KeyP', w: '24px' }, { label: '[', code: 'BracketLeft', w: '24px' }, { label: ']', code: 'BracketRight', w: '24px' },
            { label: '\\', code: 'Backslash', w: '34px' }
        ],
        [
            { label: 'Caps', code: 'CapsLock', w: '44px' },
            { label: 'A', code: 'KeyA', w: '24px' }, { label: 'S', code: 'KeyS', w: '24px' }, { label: 'D', code: 'KeyD', w: '24px' },
            { label: 'F', code: 'KeyF', w: '24px' }, { label: 'G', code: 'KeyG', w: '24px' }, { label: 'H', code: 'KeyH', w: '24px' },
            { label: 'J', code: 'KeyJ', w: '24px' }, { label: 'K', code: 'KeyK', w: '24px' }, { label: 'L', code: 'KeyL', w: '24px' },
            { label: ';', code: 'Semicolon', w: '24px' }, { label: "'", code: 'Quote', w: '24px' },
            { label: 'Enter', code: 'Enter', w: '50px' }
        ],
        [
            { label: 'Shift', code: 'ShiftLeft', w: '56px' },
            { label: 'Z', code: 'KeyZ', w: '24px' }, { label: 'X', code: 'KeyX', w: '24px' }, { label: 'C', code: 'KeyC', w: '24px' },
            { label: 'V', code: 'KeyV', w: '24px' }, { label: 'B', code: 'KeyB', w: '24px' }, { label: 'N', code: 'KeyN', w: '24px' },
            { label: 'M', code: 'KeyM', w: '24px' }, { label: ',', code: 'Comma', w: '24px' }, { label: '.', code: 'Period', w: '24px' },
            { label: '/', code: 'Slash', w: '24px' }, { label: 'Shift', code: 'ShiftRight', w: '56px' }
        ],
        [
            { label: 'Ctrl', code: 'ControlLeft', w: '32px' },
            { label: 'Win', code: 'MetaLeft', w: '32px' },
            { label: 'Alt', code: 'AltLeft', w: '32px' },
            { label: 'Space', code: 'Space', w: '140px' },
            { label: 'Alt', code: 'AltRight', w: '32px' },
            { label: 'Fn', code: 'Fn', w: '32px' },
            { label: 'Ctrl', code: 'ControlRight', w: '32px' }
        ]
    ];

    const keyElementsMap = {};
    const keyCounts = {};
    let totalKeyPressCount = 0;
    let mouseClickCount = 0;
    let keyTimestamps = [];
    let lastHand = 'right';

    function updateKPS() {
        const now = Date.now();
        keyTimestamps = keyTimestamps.filter(time => now - time < 1000);
        kpsDisplay.textContent = `${keyTimestamps.length.toFixed(1)} KPS`;
    }

    if (window.bongoKpsInterval) clearInterval(window.bongoKpsInterval);
    window.bongoKpsInterval = setInterval(updateKPS, 100);

    keyboardRows.forEach(rowKeys => {
        const rowDiv = document.createElement('div');
        rowDiv.style.display = 'flex';
        rowDiv.style.gap = '3px';
        rowDiv.style.justifyContent = 'center';
       
        rowKeys.forEach(keyInfo => {
            keyCounts[keyInfo.code] = 0;
           
            const keyEl = document.createElement('div');
            keyEl.style.width = keyInfo.w;
            keyEl.style.height = '34px';
            keyEl.style.background = '#27272a';
            keyEl.style.border = '1px solid #3f3f46';
            keyEl.style.borderRadius = '5px';
            keyEl.style.color = '#fff';
            keyEl.style.display = 'flex';
            keyEl.style.flexDirection = 'column';
            keyEl.style.alignItems = 'center';
            keyEl.style.justifyContent = 'center';
            keyEl.style.fontSize = '10px';
            keyEl.style.fontWeight = 'bold';
            keyEl.style.boxShadow = '0 2px 0 #18181b';
            keyEl.style.transition = '0.05s ease';
            keyEl.style.overflow = 'hidden';
           
            keyEl.innerHTML = `<span style="font-size: 9px; line-height: 1;">${keyInfo.label}</span><span class="count-badge" style="font-size: 8px; color: #a1a1aa; font-weight: normal; margin-top: 2px;">0</span>`;
            rowDiv.appendChild(keyEl);
            keyElementsMap[keyInfo.code.toLowerCase()] = { el: keyEl, code: keyInfo.code };
        });
        kbContainer.appendChild(rowDiv);
    });

    // 키보드 입력 이벤트
    window.addEventListener('keydown', function(event) {
        if (event.repeat) return;

        keyTimestamps.push(Date.now());
        totalKeyPressCount++;
        updateKPS();

        countDisplay.textContent = `총 타수: ${totalKeyPressCount}`;

        let keyName = event.key === ' ' ? 'Space' : event.key;
        if (event.code.startsWith('Digit')) keyName = event.code.replace('Digit', '');
        keyDisplay.textContent = `입력: [ ${keyName.toUpperCase()} ]`;

        let targetObj = keyElementsMap[event.code.toLowerCase()];
        if (!targetObj && event.key === ' ') {
            targetObj = Object.values(keyElementsMap).find(k => k.code === 'Space');
        }

        if (targetObj && targetObj.code) {
            const realCode = targetObj.code;
            keyCounts[realCode] = (keyCounts[realCode] || 0) + 1;
           
            const targetEl = targetObj.el;
            if (targetEl) {
                targetEl.style.background = '#ffb8b8';
                targetEl.style.color = '#000';
                targetEl.style.transform = 'translateY(2px)';
                targetEl.style.boxShadow = '0 0 0 #18181b';
               
                const badge = targetEl.querySelector('.count-badge');
                if (badge) {
                    badge.textContent = keyCounts[realCode];
                    badge.style.color = '#000';
                }
            }
        }

        const pawLeft = document.getElementById('paw-left');
        const pawRight = document.getElementById('paw-right');
        const leftEye = document.getElementById('left-eye');
        const rightEye = document.getElementById('right-eye');

        if (lastHand === 'right') {
            if (pawLeft) pawLeft.style.display = 'block';
            if (pawRight) pawRight.style.display = 'none';
            if (leftEye) leftEye.setAttribute('cy', '112');
            if (rightEye) rightEye.setAttribute('cy', '107');
            lastHand = 'left';
        } else {
            if (pawLeft) pawLeft.style.display = 'none';
            if (pawRight) pawRight.style.display = 'block';
            if (leftEye) leftEye.setAttribute('cy', '107');
            if (rightEye) rightEye.setAttribute('cy', '112');
            lastHand = 'right';
        }
    }, true);

    window.addEventListener('keyup', function(event) {
        let targetObj = keyElementsMap[event.code.toLowerCase()];
        if (!targetObj && event.key === ' ') {
            targetObj = Object.values(keyElementsMap).find(k => k.code === 'Space');
        }

        if (targetObj && targetObj.el) {
            targetObj.el.style.background = '#27272a';
            targetObj.el.style.color = '#fff';
            targetObj.el.style.transform = 'translateY(0)';
            targetObj.el.style.boxShadow = '0 2px 0 #18181b';
           
            const badge = targetObj.el.querySelector('.count-badge');
            if (badge) {
                badge.style.color = '#a1a1aa';
            }
        }

        const pawLeft = document.getElementById('paw-left');
        const pawRight = document.getElementById('paw-right');
        const leftEye = document.getElementById('left-eye');
        const rightEye = document.getElementById('right-eye');

        if (pawLeft) pawLeft.style.display = 'none';
        if (pawRight) pawRight.style.display = 'none';
        if (leftEye) leftEye.setAttribute('cy', '110');
        if (rightEye) rightEye.setAttribute('cy', '110');
    }, true);

    // 마우스 클릭 이벤트 (마우스 그림 클릭 시 살짝 눌리는 애니메이션)
    window.addEventListener('mousedown', function(event) {
        mouseClickCount++;
        mouseClickDisplay.textContent = `마우스: ${mouseClickCount}회`;
       
        let btnName = event.button === 2 ? '우클릭' : (event.button === 1 ? '휠클릭' : '좌클릭');
        keyDisplay.textContent = `입력: [ ${btnName} ]`;

        const mouseObj = document.getElementById('mouse-obj');
        if (mouseObj) {
            mouseObj.style.transform = 'translate(0, 3px) scale(0.95)';
        }
    }, true);

    window.addEventListener('mouseup', function(event) {
        const mouseObj = document.getElementById('mouse-obj');
        if (mouseObj) {
            mouseObj.style.transform = 'translate(0, 0) scale(1)';
        }
    }, true);

    console.log('얼굴 크기를 조금 더 줄이고 완벽한 반원형 돔 모양으로 적용된 봉고캣 위젯이 장착되었습니다!');
})();
