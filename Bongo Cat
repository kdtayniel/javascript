    'q': 'KeyQ', 'ㅂ': 'KeyQ', 'ㅃ': 'KeyQ', 'w': 'KeyW', 'ㅈ': 'KeyW', 'ㅉ': 'KeyW', 'e': 'KeyE', 'ㄷ': 'KeyE', 'ㄸ': 'KeyE', 'r': 'KeyR', 'ㄱ': 'KeyR', 'ㄲ': 'KeyR', 't': 'KeyT', 'ㅅ': 'KeyT', 'ㅆ': 'KeyT', 'y': 'KeyY', 'ㅛ': 'KeyY', 'u': 'KeyU', 'ㅕ': 'KeyU', 'i': 'KeyI', 'ㅑ': 'KeyI', 'o': 'KeyO', 'ㅐ': 'KeyO', 'ㅒ': 'KeyO', 'p': 'KeyP', 'ㅔ': 'KeyP', 'ㅖ': 'KeyP',
    '[': 'BracketLeft', '{': 'BracketLeft', ']': 'BracketRight', '}': 'BracketRight', '|': 'Backslash',
    'a': 'KeyA', 'ㅁ': 'KeyA', 's': 'KeyS', 'ㄴ': 'KeyS', 'd': 'KeyD', 'ㅇ': 'KeyD', 'f': 'KeyF', 'ㄹ': 'KeyF', 'g': 'KeyG', 'ㅎ': 'KeyG', 'h': 'KeyH', 'ㅗ': 'KeyH', 'j': 'KeyJ', 'ㅓ': 'KeyJ', 'k': 'KeyK', 'ㅏ': 'KeyK', 'l': 'KeyL', 'ㅣ': 'KeyL',
    ';': 'Semicolon', ':': 'Semicolon', "'": 'Quote', '"': 'Quote',
    'z': 'KeyZ', 'ㅋ': 'KeyZ', 'x': 'KeyX', 'ㅌ': 'KeyX', 'c': 'KeyC', 'ㅊ': 'KeyC', 'v': 'KeyV', 'ㅍ': 'KeyV', 'b': 'KeyB', 'ㅠ': 'KeyB', 'n': 'KeyN', 'ㅜ': 'KeyN', 'm': 'KeyM', 'ㅡ': 'KeyM',
    ',': 'Comma', '<': 'Comma', '.': 'Period', '>': 'Period', '/': 'Slash', '?': 'Slash',
    ' ': 'Space', 'backspace': 'Backspace', 'tab': 'Tab', 'capslock': 'CapsLock', 'enter': 'Enter', 'shift': 'ShiftLeft', 'control': 'ControlLeft', 'alt': 'AltLeft', 'meta': 'MetaLeft'
  };
  fallbackKeyMap[bsChar] = 'Backslash';

  const keyElementsMap = {};
  const keyCounts = {};
  let totalKeyPressCount = 0;
  let mouseClickCount = 0;
  let keyTimestamps = [];
  let lastHand = 'right';
  let isGoldenCat = false;
  let isDevMode = false;
  let isSkyMode = false;
  let isMiniMode = false;
  let savedPos = null;
  let codeBuffer = '';
  let charBuffer = '';
  let saveStatusTimer = null;

  function showSaveStatus(text, color) {
    saveStatus.textContent = text;
    if (color) {
      saveStatus.style.setProperty('color', color, 'important');
    } else {
      saveStatus.style.removeProperty('color');
    }
    if (saveStatusTimer) clearTimeout(saveStatusTimer);
    saveStatusTimer = setTimeout(function() {
      saveStatus.textContent = '자동 저장 켜짐';
      saveStatus.style.removeProperty('color');
    }, 1800);
  }

  function applyPosition(left, top) {
    const rect = container.getBoundingClientRect();
    const maxLeft = Math.max(0, window.innerWidth - rect.width);
    const maxTop = Math.max(0, window.innerHeight - rect.height);
    const clampedLeft = Math.min(Math.max(0, Math.round(left)), maxLeft);
    const clampedTop = Math.min(Math.max(0, Math.round(top)), maxTop);

    container.style.setProperty('left', clampedLeft + 'px', 'important');
    container.style.setProperty('top', clampedTop + 'px', 'important');
    container.style.setProperty('bottom', 'auto', 'important');
    container.style.setProperty('right', 'auto', 'important');
    savedPos = { left: clampedLeft, top: clampedTop };
  }

  function applyMiniModeUI() {
    if (isMiniMode) {
      container.classList.add('mini-mode');
      miniBtn.textContent = '+ 펼치기';
    } else {
      container.classList.remove('mini-mode');
      miniBtn.textContent = '— 접기';
    }
    if (savedPos) {
      applyPosition(savedPos.left, savedPos.top);
    }
  }

  function encodeClipboardCode() {
    const compactKeys = {};
    Object.keys(keyCounts).forEach(function(code) {
      if (keyCounts[code] > 0) compactKeys[code] = keyCounts[code];
    });
    const payload = {
      t: totalKeyPressCount,
      m: mouseClickCount,
      k: compactKeys,
      g: isGoldenCat ? 1 : 0,
      d: isDevMode ? 1 : 0,
      b: isSkyMode ? 1 : 0
    };
    return 'BONGO1:' + btoa(JSON.stringify(payload));
  }

  function decodeClipboardCode(rawText) {
    if (!rawText || typeof rawText !== 'string') return null;
    const trimmed = rawText.trim();
    if (!trimmed.startsWith('BONGO1:')) return null;
    const parsed = JSON.parse(atob(trimmed.slice(7)));
    if (!parsed || typeof parsed !== 'object') return null;
    return {
      totalKeyPressCount: Number.isFinite(parsed.t) && parsed.t >= 0 ? Math.floor(parsed.t) : 0,
      mouseClickCount: Number.isFinite(parsed.m) && parsed.m >= 0 ? Math.floor(parsed.m) : 0,
      keyCounts: parsed.k && typeof parsed.k === 'object' ? parsed.k : {},
      isGoldenCat: Boolean(parsed.g),
      isDevMode: Boolean(parsed.d),
      isSkyMode: Boolean(parsed.b)
    };
  }

  function saveState() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        totalKeyPressCount: totalKeyPressCount,
        mouseClickCount: mouseClickCount,
        keyCounts: keyCounts,
        isGoldenCat: isGoldenCat,
        isDevMode: isDevMode,
        isSkyMode: isSkyMode,
        isMiniMode: isMiniMode,
        pos: savedPos
      }));
    } catch (e) {
      showSaveStatus('저장 불가(브라우저 제한)', '#f87171');
    }
  }

  function applyCountsToUI() {
    countDisplay.textContent = '총 타수: ' + totalKeyPressCount;
    mouseClickDisplay.textContent = '마우스: ' + mouseClickCount + '회';
    Object.keys(keyElementsMap).forEach(function(lowerCode) {
      const item = keyElementsMap[lowerCode];
      item.countEl.textContent = String(keyCounts[item.code] || 0);
    });
  }

  function applyVisualModes() {
    let fillVal = 'white';
    if (isGoldenCat) fillVal = 'url(#gold-grad)';
    else if (isSkyMode) fillVal = 'url(#sky-grad)';

    const parts = ['cat-head', 'cat-ear-left', 'cat-ear-right', 'paw-left', 'paw-right'];
    parts.forEach(function(id) {
      const el = document.getElementById(id);
      if (el) el.setAttribute('fill', fillVal);
    });

    const goldSparkles = document.getElementById('gold-sparkles');
    const skySparkles = document.getElementById('sky-sparkles');
    const bg = document.getElementById('cat-bg');
    const bgColor = isSkyMode ? '#ECFEFF' : (isGoldenCat ? '#FFFBEB' : 'white');

    container.classList.toggle('golden-mode', isGoldenCat);
    container.classList.toggle('sky-mode', isSkyMode);

    if (goldSparkles) goldSparkles.style.display = isGoldenCat ? 'block' : 'none';
    if (skySparkles) skySparkles.style.display = isSkyMode ? 'block' : 'none';

    if (bg) bg.setAttribute('fill', bgColor);
    catBox.style.setProperty('background', bgColor, 'important');

    if (isSkyMode) {
      mouseClickDisplay.style.color = '#0369a1';
      countDisplay.style.color = '#1d4ed8';
      kpsDisplay.style.color = '#047857';
    } else {
      mouseClickDisplay.style.color = '#38bdf8';
      countDisplay.style.color = '#74c0fc';
      kpsDisplay.style.color = '#51cf66';
    }

    if (isDevMode) {
      container.classList.add('dev-mode');
      catSvgWrapper.style.setProperty('display', 'none', 'important');
      devArtPre.style.setProperty('display', 'flex', 'important');
      keyDisplay.style.color = isSkyMode ? '#0f172a' : '#38bdf8';
    } else {
      container.classList.remove('dev-mode');
      devArtPre.style.setProperty('display', 'none', 'important');
      catSvgWrapper.style.setProperty('display', 'block', 'important');
      keyDisplay.style.color = isSkyMode ? '#0f172a' : (isGoldenCat ? '#FFD700' : '#ffb8b8');
    }
  }

  function applyDecodedData(data, mergeMode) {
    if (mergeMode) {
      totalKeyPressCount += data.totalKeyPressCount;
      mouseClickCount += data.mouseClickCount;
      Object.keys(keyCounts).forEach(function(code) {
        const addVal = data.keyCounts[code];
        if (Number.isFinite(addVal) && addVal > 0) {
          keyCounts[code] = (keyCounts[code] || 0) + Math.floor(addVal);
        }
      });
      if (data.isSkyMode) {
        isSkyMode = true;
        isGoldenCat = false;
      } else if (data.isGoldenCat && !isSkyMode) {
        isGoldenCat = true;
      }
      isDevMode = isDevMode || data.isDevMode;
    } else {
      totalKeyPressCount = data.totalKeyPressCount;
      mouseClickCount = data.mouseClickCount;
      Object.keys(keyCounts).forEach(function(code) {
        const val = data.keyCounts[code];
        keyCounts[code] = Number.isFinite(val) && val >= 0 ? Math.floor(val) : 0;
      });
      isSkyMode = data.isSkyMode;
      isGoldenCat = !isSkyMode && data.isGoldenCat;
      isDevMode = data.isDevMode;
    }

    applyCountsToUI();
    applyVisualModes();
    saveState();
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return false;

      isMiniMode = Boolean(parsed.isMiniMode);
      applyMiniModeUI();

      if (parsed.pos && Number.isFinite(parsed.pos.left) && Number.isFinite(parsed.pos.top)) {
        applyPosition(parsed.pos.left, parsed.pos.top);
      }

      applyDecodedData({
        totalKeyPressCount: Number.isFinite(parsed.totalKeyPressCount) ? Math.floor(parsed.totalKeyPressCount) : 0,
        mouseClickCount: Number.isFinite(parsed.mouseClickCount) ? Math.floor(parsed.mouseClickCount) : 0,
        keyCounts: parsed.keyCounts || {},
        isGoldenCat: Boolean(parsed.isGoldenCat),
        isDevMode: Boolean(parsed.isDevMode),
        isSkyMode: Boolean(parsed.isSkyMode)
      }, false);
      return true;
    } catch (e) {
      return false;
    }
  }

  function resolveTargetKey(event) {
    if (event.code) {
      const byCode = keyElementsMap[event.code.toLowerCase()];
      if (byCode) return byCode;
    }
    if (event.key) {
      const mappedCode = fallbackKeyMap[event.key.toLowerCase()];
      if (mappedCode && keyElementsMap[mappedCode.toLowerCase()]) {
        return keyElementsMap[mappedCode.toLowerCase()];
      }
    }
    return null;
  }

  function toggleGoldenCat() {
    isGoldenCat = !isGoldenCat;
    if (isGoldenCat) isSkyMode = false;
    applyVisualModes();
    if (!isDevMode) {
      keyDisplay.textContent = isGoldenCat ? '★ 황금 고양이! ★' : '입력: [ 일반 모드 ]';
    }
    saveState();
  }

  function toggleSkyTheme() {
    isSkyMode = !isSkyMode;
    if (isSkyMode) isGoldenCat = false;
    applyVisualModes();
    if (!isDevMode) {
      keyDisplay.textContent = isSkyMode ? '★ 스카이 테마! ★' : '입력: [ 일반 모드 ]';
    }
    saveState();
  }

  function toggleDeveloperMode() {
    isDevMode = !isDevMode;
    applyVisualModes();
    keyDisplay.textContent = isDevMode ? '★ 개발자 모드! ★' : '입력: [ 고양이 복귀 ]';
    saveState();
  }

  function updateKPS() {
    const now = Date.now();
    keyTimestamps = keyTimestamps.filter(function(time) {
      return now - time < 1000;
    });
    kpsDisplay.textContent = keyTimestamps.length.toFixed(1) + ' KPS';
  }

  if (window.bongoKpsInterval) clearInterval(window.bongoKpsInterval);
  window.bongoKpsInterval = setInterval(updateKPS, 100);

  keyboardRows.forEach(function(rowKeys) {
    const rowDiv = document.createElement('div');
    rowDiv.className = 'bongo-kb-row';
    rowKeys.forEach(function(keyInfo) {
      keyCounts[keyInfo.code] = 0;
      const keyEl = document.createElement('div');
      keyEl.className = 'bongo-key';
      keyEl.style.setProperty('width', keyInfo.w, 'important');

      const labelSpan = document.createElement('span');
      labelSpan.className = 'bongo-key-label';
      labelSpan.textContent = keyInfo.label;

      const countSpan = document.createElement('span');
      countSpan.className = 'bongo-key-count';
      countSpan.textContent = '0';

      keyEl.appendChild(labelSpan);
      keyEl.appendChild(countSpan);
      rowDiv.appendChild(keyEl);

      keyElementsMap[keyInfo.code.toLowerCase()] = { el: keyEl, countEl: countSpan, code: keyInfo.code };
    });
    kbContainer.appendChild(rowDiv);
  });

  if (loadState()) {
    keyDisplay.textContent = '입력: [ 기록 복원됨 ]';
    showSaveStatus('이전 기록 복원됨', isSkyMode ? '#047857' : '#51cf66');
  }

  // 기존 드래그/리사이즈 리스너 정리
  if (window._bongoDragMove) document.removeEventListener('mousemove', window._bongoDragMove, true);
  if (window._bongoDragEnd) document.removeEventListener('mouseup', window._bongoDragEnd, true);
  if (window._bongoWindowResize) window.removeEventListener('resize', window._bongoWindowResize);

  // 이동 버튼 드래그 이벤트
  let isDragging = false;
  let dragOffsetX = 0;
  let dragOffsetY = 0;

  dragBtn.addEventListener('mousedown', function(event) {
    if (event.button !== 0) return;
    event.preventDefault();
    event.stopPropagation();
    this.blur();

    const rect = container.getBoundingClientRect();
    isDragging = true;
    dragOffsetX = event.clientX - rect.left;
    dragOffsetY = event.clientY - rect.top;
    applyPosition(rect.left, rect.top);
  });

  window._bongoDragMove = function(event) {
    if (!isDragging) return;
    applyPosition(event.clientX - dragOffsetX, event.clientY - dragOffsetY);
  };

  window._bongoDragEnd = function() {
    if (!isDragging) return;
    isDragging = false;
    saveState();
  };

  window._bongoWindowResize = function() {
    if (savedPos) {
      applyPosition(savedPos.left, savedPos.top);
    }
  };

  document.addEventListener('mousemove', window._bongoDragMove, true);
  document.addEventListener('mouseup', window._bongoDragEnd, true);
  window.addEventListener('resize', window._bongoWindowResize);

  // 미니 모드(접기/펼치기) 버튼 이벤트
  miniBtn.addEventListener('click', function() {
    this.blur();
    isMiniMode = !isMiniMode;
    applyMiniModeUI();
    saveState();
  });

  // 클립보드 복사
  copyBtn.addEventListener('click', function() {
    this.blur();
    const code = encodeClipboardCode();
    const okColor = isSkyMode ? '#047857' : '#51cf66';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(function() {
        showSaveStatus('클립보드에 복사됨!', okColor);
      }).catch(function() {
        prompt('아래 코드를 복사하세요 (Ctrl+C):', code);
      });
    } else {
      prompt('아래 코드를 복사하세요 (Ctrl+C):', code);
    }
  });

  // 클립보드 불러오기
  pasteBtn.addEventListener('click', async function() {
    this.blur();
    let raw = '';
    try {
      if (navigator.clipboard && navigator.clipboard.readText) {
        raw = await navigator.clipboard.readText();
      }
    } catch (e) {}

    if (!raw || !raw.trim().startsWith('BONGO1:')) {
      raw = prompt('복사한 봉고캣 기록 코드(BONGO1:...)를 붙여넣으세요:', raw || '') || '';
    }
    if (!raw) return;

    try {
      const data = decodeClipboardCode(raw);
      if (!data) {
        showSaveStatus('유효하지 않은 코드', '#dc2626');
        return;
      }
      const hasCurrent = totalKeyPressCount > 0 || mouseClickCount > 0;
      const shouldMerge = hasCurrent
        ? confirm('현재 사이트 기록과 합산할까요?\n[확인] 합산하기 (현재 + 불러온 기록)\n[취소] 불러온 기록으로 덮어쓰기')
        : false;

      applyDecodedData(data, shouldMerge);
      const okColor = isSkyMode ? '#047857' : '#51cf66';
      keyDisplay.textContent = shouldMerge ? '입력: [ 기록 합산됨 ]' : '입력: [ 기록 복원됨 ]';
      showSaveStatus(shouldMerge ? '기록 합산 완료!' : '기록 불러오기 완료!', okColor);
    } catch (e) {
      showSaveStatus('코드 해석 실패', '#dc2626');
    }
  });

  // 초기화
  resetBtn.addEventListener('click', function() {
    this.blur();
    if (!confirm('저장된 타수, 마우스 클릭, 모드 기록을 모두 초기화할까요?')) return;
    totalKeyPressCount = 0;
    mouseClickCount = 0;
    keyTimestamps = [];
    isGoldenCat = false;
    isDevMode = false;
    isSkyMode = false;
    Object.keys(keyCounts).forEach(function(code) {
      keyCounts[code] = 0;
    });
    applyCountsToUI();
    applyVisualModes();
    updateKPS();
    saveState();
    keyDisplay.textContent = '입력: [ 초기화됨 ]';
    showSaveStatus('기록 초기화 완료', '#fbbf24');
  });

  if (window._bongoKeyDown) document.removeEventListener('keydown', window._bongoKeyDown, true);
  if (window._bongoKeyUp) document.removeEventListener('keyup', window._bongoKeyUp, true);
  if (window._bongoMouseDown) document.removeEventListener('mousedown', window._bongoMouseDown, true);
  if (window._bongoMouseUp) document.removeEventListener('mouseup', window._bongoMouseUp, true);

  window._bongoKeyDown = function(event) {
    if (event.repeat) return;
    keyTimestamps.push(Date.now());
    totalKeyPressCount++;
    updateKPS();
    countDisplay.textContent = '총 타수: ' + totalKeyPressCount;

    const targetObj = resolveTargetKey(event);
    let keyName = event.key === ' ' ? 'Space' : (event.key === 'Process' && targetObj ? targetObj.code.replace('Key', '').replace('Digit', '') : event.key);
    if (event.code && event.code.startsWith('Digit')) keyName = event.code.replace('Digit', '');
    keyDisplay.textContent = '입력: [ ' + String(keyName).toUpperCase() + ' ]';

    let rawChar = '';
    const resolvedCode = targetObj ? targetObj.code : (event.code || '');
    if (resolvedCode.startsWith('Key')) rawChar = resolvedCode.replace('Key', '').toLowerCase();
    else if (resolvedCode.startsWith('Digit')) rawChar = resolvedCode.replace('Digit', '');
    else if (resolvedCode === 'Space') rawChar = ' ';
    if (rawChar) {
      codeBuffer = (codeBuffer + rawChar).slice(-30);
    }
    if (event.key && event.key.length === 1) {
      charBuffer = (charBuffer + event.key.toLowerCase()).slice(-30);
    }

    if (codeBuffer.endsWith('rhxodbs1130') || charBuffer.endsWith('고태윤1130')) {
      codeBuffer = '';
      charBuffer = '';
      toggleGoldenCat();
    }
    if (codeBuffer.endsWith('rhxodbs roqkfwk') || charBuffer.endsWith('고태윤 개발자')) {
      codeBuffer = '';
      charBuffer = '';
      toggleDeveloperMode();
    }
    if (codeBuffer.endsWith('rnjsdpwns1230') || charBuffer.endsWith('권예준1230')) {
      codeBuffer = '';
      charBuffer = '';
      toggleSkyTheme();
    }

    if (targetObj && targetObj.code) {
      const realCode = targetObj.code;
      keyCounts[realCode] = (keyCounts[realCode] || 0) + 1;
      if (targetObj.el) {
        targetObj.el.classList.add('active');
      }
      if (targetObj.countEl) {
        targetObj.countEl.textContent = String(keyCounts[realCode]);
      }
    }

    saveState();

    const pawLeft = document.getElementById('paw-left');
    const pawRight = document.getElementById('paw-right');
    const leftEye = document.getElementById('left-eye');
    const rightEye = document.getElementById('right-eye');

    if (lastHand === 'right') {
      if (pawLeft) pawLeft.style.display = 'block';
      if (pawRight) pawRight.style.display = 'none';
      if (leftEye) leftEye.setAttribute('cy', '112');
      if (rightEye) rightEye.setAttribute('cy', '107');
      lastHand = 'left';
    } else {
      if (pawLeft) pawLeft.style.display = 'none';
      if (pawRight) pawRight.style.display = 'block';
      if (leftEye) leftEye.setAttribute('cy', '107');
      if (rightEye) rightEye.setAttribute('cy', '112');
      lastHand = 'right';
    }
  };

  window._bongoKeyUp = function(event) {
    const targetObj = resolveTargetKey(event);
    if (targetObj && targetObj.el) {
      targetObj.el.classList.remove('active');
    }
    const pawLeft = document.getElementById('paw-left');
    const pawRight = document.getElementById('paw-right');
    const leftEye = document.getElementById('left-eye');
    const rightEye = document.getElementById('right-eye');
    if (pawLeft) pawLeft.style.display = 'none';
    if (pawRight) pawRight.style.display = 'none';
    if (leftEye) leftEye.setAttribute('cy', '110');
    if (rightEye) rightEye.setAttribute('cy', '110');
  };

  window._bongoMouseDown = function(event) {
    if (event.target && event.target.closest && (event.target.closest('.bongo-ctrl-bar') || event.target.closest('.bongo-top-bar'))) {
      return;
    }

    mouseClickCount++;
    mouseClickDisplay.textContent = '마우스: ' + mouseClickCount + '회';
    let btnName = event.button === 2 ? '우클릭' : (event.button === 1 ? '휠클릭' : '좌클릭');
    keyDisplay.textContent = '입력: [ ' + btnName + ' ]';

    saveState();

    const mouseObj = document.getElementById('mouse-obj');
    if (mouseObj) {
      mouseObj.style.transform = 'translate(0, 3px) scale(0.95)';
    }
  };

  window._bongoMouseUp = function() {
    const mouseObj = document.getElementById('mouse-obj');
    if (mouseObj) {
      mouseObj.style.transform = 'translate(0, 0) scale(1)';
    }
  };

  document.addEventListener('keydown', window._bongoKeyDown, true);
  document.addEventListener('keyup', window._bongoKeyUp, true);
  document.addEventListener('mousedown', window._bongoMouseDown, true);
  document.addEventListener('mouseup', window._bongoMouseUp, true);

  console.log('봉고캣 위젯 (권예준1230 스카이 전체 테마 포함) 실행 완료!');
})();
































(function() {
