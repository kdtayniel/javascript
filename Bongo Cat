function findTargetCode(e) {
if (e.code && keyDOMMap[e.code]) return e.code;
if (aliasMap[e.key]) return aliasMap[e.key];
const upperKey = e.key ? e.key.toUpperCase() : '';
const standardCode = 'Key' + upperKey;
if (keyDOMMap[standardCode]) return standardCode;
const digitCode = 'Digit' + e.key;
if (keyDOMMap[digitCode]) return digitCode;
return null;
}
// 봉고캣 애니메이션 업데이트 (스페이스바 양손 기능 반영)
function updateBongoCatAnimation() {
let hasLeft = false;
let hasRight = false;
let isSpacePressed = activeKeys.has('Space'); // 스페이스바가 눌렸는지 확인
// 스페이스바가 눌려있다면 무조건 양손 상태로 취급
if (isSpacePressed) {
hasLeft = true;
hasRight = true;
} else {
activeKeys.forEach(code => {
if (keyDOMMap[code]) {
if (keyDOMMap[code].root.dataset.side === 'left') hasLeft = true;
if (keyDOMMap[code].root.dataset.side === 'right') hasRight = true;
}
});
}
// 1. 텍스트 아트 애니메이션 업데이트
if (hasLeft && hasRight) {
catFace.textContent = catFrames.both;
} else if (hasLeft) {
catFace.textContent = catFrames.left;
} else if (hasRight) {
catFace.textContent = catFrames.right;
} else {
catFace.textContent = catFrames.default;
}
// 2. 물리 솜방망이 업데이트
if (hasLeft) {
leftPaw.style.transform = 'translateY(45px) scale(0.9)';
leftPaw.style.background = '#ffb8b8';
} else {
leftPaw.style.transform = 'translateY(0px) scale(1)';
leftPaw.style.background = '#ffffff';
}
if (hasRight) {
rightPaw.style.transform = 'translateY(45px) scale(0.9)';
rightPaw.style.background = '#ffb8b8';
} else {
rightPaw.style.transform = 'translateY(0px) scale(1)';
rightPaw.style.background = '#ffffff';
}
}
function handleKeyDown(e) {
const code = findTargetCode(e);
if (!code || !keyDOMMap[code]) return;
if (activeKeys.has(code)) return;
activeKeys.add(code);
keyTimestamps.push(Date.now());
keyCounters[code]++;
keyDOMMap[code].count.textContent = keyCounters[code];
keyDOMMap[code].count.style.color = '#1e1e1e';
const targetKey = keyDOMMap[code].root;
targetKey.style.background = '#ffb8b8';
keyDOMMap[code].label.style.color = '#1e1e1e';
targetKey.style.transform = 'translateY(1px)';
keyDisplay.textContent = "누른 키: [ " + keyDOMMap[code].label.textContent + " ]";
updateBongoCatAnimation();
}
function handleKeyUp(e) {
const code = findTargetCode(e);
if (!code || !keyDOMMap[code]) return;
activeKeys.delete(code);
keyDOMMap[code].count.style.color = '#888';
const targetKey = keyDOMMap[code].root;
targetKey.style.background = '#2a2a2a';
keyDOMMap[code].label.style.color = '#ccc';
targetKey.style.transform = 'translateY(0px)';
updateBongoCatAnimation();
}
window.addEventListener('keydown', handleKeyDown, { capture: true, passive: true });
window.addEventListener('keyup', handleKeyUp, { capture: true, passive: true });
document.addEventListener('keydown', handleKeyDown, { capture: true, passive: true });
document.addEventListener('keyup', handleKeyUp, { capture: true, passive: true });
})();

























