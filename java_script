(function startConsolePoopGame() {
    console.clear();
    alert("💩 [콘솔 실시간 똥피하기 Game]\n\n조작 방법:\nA 키 : 왼쪽으로 이동\nD 키 : 오른쪽으로 이동\n\n하늘에서 떨어지는 똥을 요리조리 피해보세요!");

    const WIDTH = 22;  // 게임 화면 가로 크기
    const HEIGHT = 14; // 게임 화면 세로 크기
    let playerX = Math.floor(WIDTH / 2);
    let score = 0;
    let gameOver = false;
    let gameLoopInterval = null;

    // 똥 목록: {x, y, speed}
    let poops = [];

    // 키보드 입력 감지 (A, D)
    function handleKeyDown(e) {
        if (gameOver) return;
        const key = e.key.toLowerCase();
        if (key === 'a' || key === 'ㅁ') {
            if (playerX > 0) playerX--;
        } else if (key === 'd' || key === 'ㅇ') {
            if (playerX < WIDTH - 1) playerX++;
        }
        render(); // 키 입력 시 즉시 화면 갱신해서 반응성 향상
    }
    window.addEventListener('keydown', handleKeyDown);

    // 게임 화면 렌더링 함수
    function render() {
        if (gameOver) return;

        let board = Array(HEIGHT).fill(null).map(() => Array(WIDTH).fill("　"));
        
        // 캐릭터 배치 (맨 아래 줄)
        board[HEIGHT - 1][playerX] = "🏃";

        // 똥 배치 및 충돌 검사
        poops.forEach(poop => {
            let px = Math.floor(poop.x);
            let py = Math.floor(poop.y);
            if (py >= 0 && py < HEIGHT && px >= 0 && px < WIDTH) {
                board[py][px] = "💩";
            }
        });

        // 콘솔 화면 갱신
        console.clear();
        console.log(`%c✨ 버틴 시간(SCORE): ${score} ✨  [ A: ◀ | D: ▶ ]`, "color: #ffff00; font-size: 14px; font-weight: bold;");
        console.log("┌" + "─".repeat(WIDTH * 2) + "┐");
        
        for (let y = 0; y < HEIGHT; y++) {
            console.log("│" + board[y].join("") + "│");
        }
        
        console.log("└" + "─".repeat(WIDTH * 2) + "┘");
    }

    // 메인 게임 루프 (0.08초마다 실행 - 기존보다 더 빠름!)
    function update() {
        score++;

        // 난이도 조절: 시간이 지날수록 새로운 똥이 더 자주 생성됨
        let spawnChance = 0.3 + (score * 0.001);
        if (Math.random() < Math.min(spawnChance, 0.7)) {
            poops.push({
                x: Math.floor(Math.random() * WIDTH),
                y: 0,
                // 각각 떨어지는 속도가 다름 (다이내믹한 낙하)
                speed: 0.6 + Math.random() * 0.8
            });
        }

        // 똥 위치 하강
        poops.forEach(poop => {
            poop.y += poop.speed;
        });

        // 충돌 체크
        for (let i = 0; i < poops.length; i++) {
            let poop = poops[i];
            let px = Math.floor(poop.x);
            let py = Math.floor(poop.y);

            // 캐릭터 위치와 똥의 위치가 겹치면 종료
            if (py === HEIGHT - 1 && px === playerX) {
                endGame();
                return;
            }
        }

        // 화면 아래로 벗어난 똥 제거
        poops = poops.filter(poop => poop.y < HEIGHT);

        render();
    }

    // 게임 종료 처리
    function endGame() {
        gameOver = true;
        clearInterval(gameLoopInterval);
        window.removeEventListener('keydown', handleKeyDown);
        
        console.clear();
        console.log("%c😭😭 으아악! 똥을 맞았습니다! 😭😭", "color: #ff5555; font-size: 20px; font-weight: bold;");
        console.log(`%c최종 생존 점수: ${score}점`, "color: #ffff00; font-size: 16px; font-weight: bold;");
        alert(`💩 으악! 똥을 피하지 못했습니다!\n최종 점수: ${score}점`);
    }

    // 게임 루프 구동 (80ms 주기)
    gameLoopInterval = setInterval(update, 80);
})();
