(function() {
    // 이미 실행 중인 깜빡임이 있다면 제거
    if (window.blinkInterval) {
        clearInterval(window.blinkInterval);
    }
    
    const html = document.documentElement;
    let inverted = false;

    // 0.1초(100ms)마다 화면을 반전시킵니다.
    window.blinkInterval = setInterval(() => {
        if (!inverted) {
            html.style.filter = 'invert(100%)';
            html.style.backgroundColor = 'black';
        } else {
            html.style.filter = '';
            html.style.backgroundColor = '';
        }
        inverted = !inverted;
    }, 100); // 속도 조절: 100을 50으로 줄이면 2배 더 빠르게 깜빡입니다.
})();
