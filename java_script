function backupSpreadsheet() {
  var fileId = SpreadsheetApp.getActiveSpreadsheet().getId();
  var file = DriveApp.getFileById(fileId);
  
  // 백업 파일이 저장될 구글 드라이브 폴더 ID
  var folderId = "여기에_구글_드라이브_폴더_ID를_넣으세요";
  var folder = DriveApp.getFolderById(folderId);
  
  // 오늘 날짜를 구해서 파일 이름에 붙임
  var formattedDate = Utilities.formatDate(new Date(), "GMT+9", "yyyy-MM-dd");
  var backupName = file.getName() + "_백업_" + formattedDate;
  
  // 복사본 생성 후 해당 폴더로 이동
  file.makeCopy(backupName, folder);
}
