const startCountdown = (durationInSeconds, displayElement) => {
  let timer = durationInSeconds;
  
  const interval = setInterval(() => {
    const minutes = Math.floor(timer / 60);
    const seconds = timer % 60;

    // 한 자릿수일 때 앞에 0 붙이기 (예: 05:09)
    const displayMin = String(minutes).padStart(2, '0');
    const displaySec = String(seconds).padStart(2, '0');

    displayElement.textContent = `${displayMin}:${displaySec}`;

    if (--timer < 0) {
      clearInterval(interval);
      displayElement.textContent = "시간 만료";
      alert("제한 시간이 초과되었습니다.");
    }
  }, 1000);
};

// 사용 예시: 3분(180초) 카운트다운 시작
