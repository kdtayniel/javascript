        }
      });
      isGoldenCat = isGoldenCat || data.isGoldenCat;
      isDevMode = isDevMode || data.isDevMode;
    } else {
      totalKeyPressCount = data.totalKeyPressCount;
      mouseClickCount = data.mouseClickCount;
      Object.keys(keyCounts).forEach(function(code) {
        const val = data.keyCounts[code];
        keyCounts[code] = Number.isFinite(val) && val >= 0 ? Math.floor(val) : 0;
      });
      isGoldenCat = data.isGoldenCat;
      isDevMode = data.isDevMode;
    }

    applyCountsToUI();
    applyVisualModes();
    saveState();
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return false;
      applyDecodedData({
        totalKeyPressCount: Number.isFinite(parsed.totalKeyPressCount) ? Math.floor(parsed.totalKeyPressCount) : 0,
        mouseClickCount: Number.isFinite(parsed.mouseClickCount) ? Math.floor(parsed.mouseClickCount) : 0,
        keyCounts: parsed.keyCounts || {},
        isGoldenCat: Boolean(parsed.isGoldenCat),
        isDevMode: Boolean(parsed.isDevMode)
      }, false);
      return true;
    } catch (e) {
      return false;
    }
  }

  function resolveTargetKey(event) {
    if (event.code) {
      const byCode = keyElementsMap[event.code.toLowerCase()];
      if (byCode) return byCode;
    }
    if (event.key) {
      const mappedCode = fallbackKeyMap[event.key.toLowerCase()];
      if (mappedCode && keyElementsMap[mappedCode.toLowerCase()]) {
        return keyElementsMap[mappedCode.toLowerCase()];
      }
    }
    return null;
  }

  function toggleGoldenCat() {
    isGoldenCat = !isGoldenCat;
    applyVisualModes();
    if (!isDevMode) {
      keyDisplay.textContent = isGoldenCat ? '★ 황금 고양이! ★' : '입력: [ 일반 모드 ]';
    }
    saveState();
  }

  function toggleDeveloperMode() {
    isDevMode = !isDevMode;
    applyVisualModes();
    keyDisplay.textContent = isDevMode ? '★ 개발자 모드! ★' : '입력: [ 고양이 복귀 ]';
    saveState();
  }

  function updateKPS() {
    const now = Date.now();
    keyTimestamps = keyTimestamps.filter(function(time) {
      return now - time < 1000;
    });
    kpsDisplay.textContent = keyTimestamps.length.toFixed(1) + ' KPS';
  }

  if (window.bongoKpsInterval) clearInterval(window.bongoKpsInterval);
  window.bongoKpsInterval = setInterval(updateKPS, 100);

  keyboardRows.forEach(function(rowKeys) {
    const rowDiv = document.createElement('div');
    rowDiv.className = 'bongo-kb-row';
    rowKeys.forEach(function(keyInfo) {
      keyCounts[keyInfo.code] = 0;
      const keyEl = document.createElement('div');
      keyEl.className = 'bongo-key';
      keyEl.style.setProperty('width', keyInfo.w, 'important');

      const labelSpan = document.createElement('span');
      labelSpan.className = 'bongo-key-label';
      labelSpan.textContent = keyInfo.label;

      const countSpan = document.createElement('span');
      countSpan.className = 'bongo-key-count';
      countSpan.textContent = '0';

      keyEl.appendChild(labelSpan);
      keyEl.appendChild(countSpan);
      rowDiv.appendChild(keyEl);

      keyElementsMap[keyInfo.code.toLowerCase()] = { el: keyEl, countEl: countSpan, code: keyInfo.code };
    });
    kbContainer.appendChild(rowDiv);
  });

  if (loadState()) {
    keyDisplay.textContent = '입력: [ 기록 복원됨 ]';
    showSaveStatus('이전 기록 복원됨', '#51cf66');
  }

  // 클립보드 복사
  copyBtn.addEventListener('click', function() {
    this.blur();
    const code = encodeClipboardCode();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(function() {
        showSaveStatus('클립보드에 복사됨!', '#51cf66');
      }).catch(function() {
        prompt('아래 코드를 복사하세요 (Ctrl+C):', code);
      });
    } else {
      prompt('아래 코드를 복사하세요 (Ctrl+C):', code);
    }
  });

  // 클립보드 불러오기 (자동 읽기 실패 시 입력창 표시)
  pasteBtn.addEventListener('click', async function() {
    this.blur();
    let raw = '';
    try {
      if (navigator.clipboard && navigator.clipboard.readText) {
        raw = await navigator.clipboard.readText();
      }
    } catch (e) {}

    if (!raw || !raw.trim().startsWith('BONGO1:')) {
      raw = prompt('복사한 봉고캣 기록 코드(BONGO1:...)를 붙여넣으세요:', raw || '') || '';
    }
    if (!raw) return;

    try {
      const data = decodeClipboardCode(raw);
      if (!data) {
        showSaveStatus('유효하지 않은 코드', '#f87171');
        return;
      }
      const hasCurrent = totalKeyPressCount > 0 || mouseClickCount > 0;
      const shouldMerge = hasCurrent
        ? confirm('현재 사이트 기록과 합산할까요?\n[확인] 합산하기 (현재 + 불러온 기록)\n[취소] 불러온 기록으로 덮어쓰기')
        : false;

      applyDecodedData(data, shouldMerge);
      keyDisplay.textContent = shouldMerge ? '입력: [ 기록 합산됨 ]' : '입력: [ 기록 복원됨 ]';
      showSaveStatus(shouldMerge ? '기록 합산 완료!' : '기록 불러오기 완료!', '#51cf66');
    } catch (e) {
      showSaveStatus('코드 해석 실패', '#f87171');
    }
  });

  // 초기화
  resetBtn.addEventListener('click', function() {
    this.blur();
    if (!confirm('저장된 타수, 마우스 클릭, 모드 기록을 모두 초기화할까요?')) return;
    totalKeyPressCount = 0;
    mouseClickCount = 0;
    keyTimestamps = [];
    isGoldenCat = false;
    isDevMode = false;
    Object.keys(keyCounts).forEach(function(code) {
      keyCounts[code] = 0;
    });
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch (e) {}
    applyCountsToUI();
    applyVisualModes();
    updateKPS();
    keyDisplay.textContent = '입력: [ 초기화됨 ]';
    showSaveStatus('기록 초기화 완료', '#fbbf24');
  });

  if (window._bongoKeyDown) document.removeEventListener('keydown', window._bongoKeyDown, true);
  if (window._bongoKeyUp) document.removeEventListener('keyup', window._bongoKeyUp, true);
  if (window._bongoMouseDown) document.removeEventListener('mousedown', window._bongoMouseDown, true);
  if (window._bongoMouseUp) document.removeEventListener('mouseup', window._bongoMouseUp, true);

  window._bongoKeyDown = function(event) {
    if (event.repeat) return;
    keyTimestamps.push(Date.now());
    totalKeyPressCount++;
    updateKPS();
    countDisplay.textContent = '총 타수: ' + totalKeyPressCount;

    const targetObj = resolveTargetKey(event);
    let keyName = event.key === ' ' ? 'Space' : (event.key === 'Process' && targetObj ? targetObj.code.replace('Key', '').replace('Digit', '') : event.key);
    if (event.code && event.code.startsWith('Digit')) keyName = event.code.replace('Digit', '');
    keyDisplay.textContent = '입력: [ ' + String(keyName).toUpperCase() + ' ]';

    let rawChar = '';
    const resolvedCode = targetObj ? targetObj.code : (event.code || '');
    if (resolvedCode.startsWith('Key')) rawChar = resolvedCode.replace('Key', '').toLowerCase();
    else if (resolvedCode.startsWith('Digit')) rawChar = resolvedCode.replace('Digit', '');
    else if (resolvedCode === 'Space') rawChar = ' ';
    if (rawChar) {
      codeBuffer = (codeBuffer + rawChar).slice(-30);
    }
    if (event.key && event.key.length === 1) {
      charBuffer = (charBuffer + event.key.toLowerCase()).slice(-30);
    }

    if (codeBuffer.endsWith('rhxodbs1130') || charBuffer.endsWith('고태윤1130')) {
      codeBuffer = '';
      charBuffer = '';
      toggleGoldenCat();
    }
    if (codeBuffer.endsWith('rhxodbs roqkfwk') || charBuffer.endsWith('고태윤 개발자')) {
      codeBuffer = '';
      charBuffer = '';
      toggleDeveloperMode();
    }

    if (targetObj && targetObj.code) {
      const realCode = targetObj.code;
      keyCounts[realCode] = (keyCounts[realCode] || 0) + 1;
      if (targetObj.el) {
        targetObj.el.classList.add('active');
      }
      if (targetObj.countEl) {
        targetObj.countEl.textContent = String(keyCounts[realCode]);
      }
    }

    saveState();

    const pawLeft = document.getElementById('paw-left');
    const pawRight = document.getElementById('paw-right');
    const leftEye = document.getElementById('left-eye');
    const rightEye = document.getElementById('right-eye');

    if (lastHand === 'right') {
      if (pawLeft) pawLeft.style.display = 'block';
      if (pawRight) pawRight.style.display = 'none';
      if (leftEye) leftEye.setAttribute('cy', '112');
      if (rightEye) rightEye.setAttribute('cy', '107');
      lastHand = 'left';
    } else {
      if (pawLeft) pawLeft.style.display = 'none';
      if (pawRight) pawRight.style.display = 'block';
      if (leftEye) leftEye.setAttribute('cy', '107');
      if (rightEye) rightEye.setAttribute('cy', '112');
      lastHand = 'right';
    }
  };

  window._bongoKeyUp = function(event) {
    const targetObj = resolveTargetKey(event);
    if (targetObj && targetObj.el) {
      targetObj.el.classList.remove('active');
    }
    const pawLeft = document.getElementById('paw-left');
    const pawRight = document.getElementById('paw-right');
    const leftEye = document.getElementById('left-eye');
    const rightEye = document.getElementById('right-eye');
    if (pawLeft) pawLeft.style.display = 'none';
    if (pawRight) pawRight.style.display = 'none';
    if (leftEye) leftEye.setAttribute('cy', '110');
    if (rightEye) rightEye.setAttribute('cy', '110');
  };

  window._bongoMouseDown = function(event) {
    if (event.target && event.target.closest && event.target.closest('.bongo-ctrl-bar')) return;

    mouseClickCount++;
    mouseClickDisplay.textContent = '마우스: ' + mouseClickCount + '회';
    let btnName = event.button === 2 ? '우클릭' : (event.button === 1 ? '휠클릭' : '좌클릭');
    keyDisplay.textContent = '입력: [ ' + btnName + ' ]';

    saveState();

    const mouseObj = document.getElementById('mouse-obj');
    if (mouseObj) {
      mouseObj.style.transform = 'translate(0, 3px) scale(0.95)';
    }
  };

  window._bongoMouseUp = function() {
    const mouseObj = document.getElementById('mouse-obj');
    if (mouseObj) {
      mouseObj.style.transform = 'translate(0, 0) scale(1)';
    }
  };

  document.addEventListener('keydown', window._bongoKeyDown, true);
  document.addEventListener('keyup', window._bongoKeyUp, true);
  document.addEventListener('mousedown', window._bongoMouseDown, true);
  document.addEventListener('mouseup', window._bongoMouseUp, true);

  console.log('봉고캣 위젯 (클립보드 복사/불러오기 + 자동 저장 포함) 실행 완료!');
})();
