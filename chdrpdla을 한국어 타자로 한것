(function() {
  const oldCanvas = document.getElementById('fps-canvas-container');
  if (oldCanvas) oldCanvas.remove();

  const script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';

  script.onload = () => {
    const container = document.createElement('div');
    container.id = 'fps-canvas-container';
    container.style.cssText = 'position:fixed; top:0; left:0; width:100vw; height:100vh; z-index:999999; background:#000; font-family:sans-serif; user-select:none;';
    
    container.innerHTML = `
      <div id="crosshair" style="position:absolute; top:50%; left:50%; width:8px; height:8px; background:rgba(0,255,0,0.8); border-radius:50%; transform:translate(-50%,-50%); pointer-events:none; z-index:10;"></div>
      
      <!-- 저격 스코프 오버레이 -->
      <div id="scope-overlay" style="position:absolute; top:0; left:0; width:100vw; height:100vh; background:radial-gradient(circle, transparent 20%, rgba(0,0,0,0.95) 40%); display:none; pointer-events:none; z-index:15;">
        <div style="position:absolute; top:50%; left:0; width:100%; height:2px; background:rgba(0,255,0,0.5);"></div>
        <div style="position:absolute; top:0; left:50%; width:2px; height:100%; background:rgba(0,255,0,0.5);"></div>
      </div>

      <div id="hud" style="position:absolute; bottom:20px; left:20px; color:#0f0; font-size:20px; font-weight:bold; text-shadow:0 0 5px #000; pointer-events:none; z-index:20;">
        WEAPON: <span id="w-name">AK-47</span> (1) | AMMO: <span id="ammo">30</span> | MAGS: <span id="mags">∞</span> | SCORE: <span id="score">0</span>
      </div>
      <div id="instructions" style="position:absolute; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); color:#fff; display:flex; flex-direction:column; justify-content:center; align-items:center; cursor:pointer; z-index:25;">
        <h1 style="font-size:40px; margin-bottom:10px;">FPS WEAPON LAB</h1>
        <p>무기 선택: 1(AK-47) 2(저격소총) 3(단검)</p>
        <p>🗡️ <b>단검 특치</b>: 이동속도 증가 | 평타 40 | 우클릭 등(백스탭) 150 데미지</p>
        <p>장전: R | 화면 클릭 시 시작 | 나가기: ESC</p>
      </div>
    `;
    document.body.appendChild(container);

    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playSound(type) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'ak') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(350, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
      } else if (type === 'sniper') {
        osc.type = 'square';
        osc.frequency.setValueAtTime(120, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(20, audioCtx.currentTime + 0.3);
        gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
      } else if (type === 'knife') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
      } else if (type === 'backstab') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
      }
      osc.start();
      osc.stop(audioCtx.currentTime + 0.3);
    }

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x111115);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.y = 1.6;
    scene.add(camera);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));

    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(100, 100),
      new THREE.MeshBasicMaterial({ color: 0x22222a, wireframe: true })
    );
    floor.rotation.x = -Math.PI / 2;
    scene.add(floor);

    // 🔫 AK-47
    function createAK47() {
      const group = new THREE.Group();
      const mMat = new THREE.MeshBasicMaterial({ color: 0x222222 });
      const wMat = new THREE.MeshBasicMaterial({ color: 0x8b4513 });
      group.add(new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.1, 0.4), mMat));
      const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.5, 8), mMat);
      barrel.rotation.x = Math.PI / 2; barrel.position.set(0, 0.02, -0.4);
      group.add(barrel);
      const stock = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.12, 0.35), wMat);
      stock.position.set(0, -0.02, 0.35); stock.rotation.x = -0.1;
      group.add(stock);
      const hand = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.08, 0.25), wMat);
      hand.position.set(0, 0.01, -0.28);
      group.add(hand);
      const mag = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.25, 0.09), mMat);
      mag.position.set(0, -0.15, -0.08); mag.rotation.x = 0.35;
      group.add(mag);
      const flash = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8), new THREE.MeshBasicMaterial({ color: 0xffaa00, visible: false }));
      flash.position.set(0, 0.02, -0.67);
      group.add(flash);
      group.userData.flash = flash;
      group.position.set(0.22, -0.18, -0.42);
      return group;
    }

    // 🎯 저격소총
    function createSniper() {
      const group = new THREE.Group();
      const mMat = new THREE.MeshBasicMaterial({ color: 0x1a1a1a });
      const wMat = new THREE.MeshBasicMaterial({ color: 0x5c4033 });
      group.add(new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.09, 0.5), mMat));
      const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.01, 0.01, 0.9, 8), mMat);
      barrel.rotation.x = Math.PI / 2; barrel.position.set(0, 0.02, -0.65);
      group.add(barrel);
      const scope = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.25, 8), mMat);
      scope.rotation.x = Math.PI / 2; scope.position.set(0, 0.08, -0.1);
      group.add(scope);
      const stock = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.1, 0.45), wMat);
      stock.position.set(0, -0.01, 0.4); stock.rotation.x = -0.05;
      group.add(stock);
      const flash = new THREE.Mesh(new THREE.SphereGeometry(0.05, 8, 8), new THREE.MeshBasicMaterial({ color: 0x00ffff, visible: false }));
      flash.position.set(0, 0.02, -1.1);
      group.add(flash);
      group.userData.flash = flash;
      group.position.set(0.2, -0.16, -0.4);
      return group;
    }

    // 🗡️ 단검 모델 생성
    function createDagger() {
      const group = new THREE.Group();
      const bladeMat = new THREE.MeshBasicMaterial({ color: 0xcccccc });
      const handleMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
      const guardMat = new THREE.MeshBasicMaterial({ color: 0xd4af37 });

      const blade = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.35, 0.05), bladeMat);
      blade.position.set(0, 0.2, 0);
      group.add(blade);
      const guard = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.02, 0.12), guardMat);
      guard.position.set(0, 0.02, 0);
      group.add(guard);
      const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.15, 8), handleMat);
      handle.position.set(0, -0.06, 0);
      group.add(handle);

      group.position.set(0.25, -0.2, -0.35);
      group.rotation.x = Math.PI / 3;
      return group;
    }

    const akModel = createAK47();
    const sniperModel = createSniper();
    const daggerModel = createDagger();
    
    sniperModel.visible = false;
    daggerModel.visible = false;
    
    camera.add(akModel);
    camera.add(sniperModel);
    camera.add(daggerModel);

    // 상태 변수
    let currentWeapon = 'AK-47'; 
    let akAmmo = 30;
    let sniperMagCapacity = 3;
    let sniperAmmo = 3;
    let sniperMags = 6;

    let score = 0;
    let isFiring = false;
    let fireTimer = 0;
    let isScoped = false;

    const targets = [];
    const hitMeshes = [];

    function updateHUD() {
      document.getElementById('w-name').innerText = currentWeapon;
      if (currentWeapon === 'AK-47') {
        document.getElementById('ammo').innerText = akAmmo;
        document.getElementById('mags').innerText = '∞';
      } else if (currentWeapon === 'Sniper') {
        document.getElementById('ammo').innerText = sniperAmmo;
        document.getElementById('mags').innerText = sniperMags;
      } else {
        document.getElementById('ammo').innerText = '∞';
        document.getElementById('mags').innerText = '∞';
      }
    }

    // 적 생성
    function createHumanEnemy() {
      const humanGroup = new THREE.Group();
      const bodyMat = new THREE.MeshBasicMaterial({ color: 0xcc2222 });
      const headMat = new THREE.MeshBasicMaterial({ color: 0xffccaa });

      const head = new THREE.Mesh(new THREE.SphereGeometry(0.25, 12, 12), headMat);
      head.position.y = 1.65;
      head.userData.isHead = true;
      humanGroup.add(head);

      const torso = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.7, 0.3), bodyMat);
      torso.position.y = 1.15;
      humanGroup.add(torso);

      const leftArm = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.6, 0.15), bodyMat);
      leftArm.position.set(-0.35, 1.15, 0); humanGroup.add(leftArm);

      const rightArm = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.6, 0.15), bodyMat);
      rightArm.position.set(0.35, 1.15, 0); humanGroup.add(rightArm);

      const leftLeg = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.8, 0.2), bodyMat);
      leftLeg.position.set(-0.15, 0.4, 0); humanGroup.add(leftLeg);

      const rightLeg = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.8, 0.2), bodyMat);
      rightLeg.position.set(0.15, 0.4, 0); humanGroup.add(rightLeg);

      humanGroup.userData = { hp: 150 };

      humanGroup.children.forEach(child => {
        child.userData.parentGroup = humanGroup;
        hitMeshes.push(child);
      });

      return humanGroup;
    }

    function spawnEnemy() {
      const enemy = createHumanEnemy();
      enemy.position.set((Math.random() - 0.5) * 40, 0, (Math.random() - 0.5) * 40);
      scene.add(enemy);
      targets.push(enemy);
    }

    for (let i = 0; i < 8; i++) spawnEnemy();

    let isLocked = false;
    const instructions = document.getElementById('instructions');
    instructions.onclick = () => {
      container.requestPointerLock();
      if (audioCtx.state === 'suspended') audioCtx.resume();
    };

    document.addEventListener('pointerlockchange', () => {
      isLocked = (document.pointerLockElement === container);
      instructions.style.display = isLocked ? 'none' : 'flex';
    });

    let yaw = 0, pitch = 0;
    document.addEventListener('mousemove', (e) => {
      if (!isLocked) return;
      const sensitivity = isScoped ? 0.0007 : 0.002;
      yaw -= e.movementX * sensitivity;
      pitch -= e.movementY * sensitivity;
      pitch = Math.max(-1.5, Math.min(1.5, pitch));
      camera.rotation.set(pitch, yaw, 0, 'YXZ');
    });

    const move = { w: 0, a: 0, s: 0, d: 0 };
    document.addEventListener('keydown', (e) => {
      if (e.code === 'KeyW') move.w = 1;
      if (e.code === 'KeyS') move.s = 1;
      if (e.code === 'KeyA') move.a = 1;
      if (e.code === 'KeyD') move.d = 1;
      
      if (e.code === 'Digit1') {
        currentWeapon = 'AK-47';
        akModel.visible = true; sniperModel.visible = false; daggerModel.visible = false;
        toggleScope(false); updateHUD();
      }
      if (e.code === 'Digit2') {
        currentWeapon = 'Sniper';
        akModel.visible = false; sniperModel.visible = true; daggerModel.visible = false;
        updateHUD();
      }
      if (e.code === 'Digit3') {
        currentWeapon = 'Dagger';
        akModel.visible = false; sniperModel.visible = false; daggerModel.visible = true;
        toggleScope(false); updateHUD();
      }
      if (e.code === 'KeyR' && isLocked) {
        if (currentWeapon === 'AK-47') akAmmo = 30;
        else if (currentWeapon === 'Sniper' && sniperMags > 0 && sniperAmmo < sniperMagCapacity) {
          sniperMags--; sniperAmmo = sniperMagCapacity;
        }
        updateHUD();
      }
    });

    document.addEventListener('keyup', (e) => {
      if (e.code === 'KeyW') move.w = 0;
      if (e.code === 'KeyS') move.s = 0;
      if (e.code === 'KeyA') move.a = 0;
      if (e.code === 'KeyD') move.d = 0;
    });

    document.addEventListener('mousedown', (e) => {
      if (!isLocked) return;
      if (e.button === 0) {
        isFiring = true;
        if (currentWeapon === 'Sniper' || currentWeapon === 'Dagger') shootWeapon(false); 
      } else if (e.button === 2) {
        if (currentWeapon === 'Sniper') toggleScope(!isScoped);
        else if (currentWeapon === 'Dagger') shootWeapon(true); 
      }
    });

    document.addEventListener('mouseup', (e) => {
      if (e.button === 0) isFiring = false;
    });

    document.addEventListener('contextmenu', (e) => {
      e.preventDefault();
    });

    function toggleScope(enable) {
      isScoped = enable;
      document.getElementById('scope-overlay').style.display = isScoped ? 'block' : 'none';
      document.getElementById('crosshair').style.display = isScoped ? 'none' : 'block';
      camera.fov = isScoped ? 25 : 75;
      camera.updateProjectionMatrix();
      if (currentWeapon === 'Sniper') sniperModel.visible = !isScoped;
    }

    const raycaster = new THREE.Raycaster();
    function shootWeapon(isRightClick = false) {
      if (currentWeapon === 'AK-47') {
        if (akAmmo <= 0) return;
        akAmmo--;
      } else if (currentWeapon === 'Sniper') {
        if (sniperAmmo <= 0) return;
        sniperAmmo--;
      }
      updateHUD();

      if (currentWeapon === 'Dagger') {
        daggerModel.rotation.z -= 0.8;
        daggerModel.position.z -= 0.1;
      } else {
        const activeModel = (currentWeapon === 'AK-47') ? akModel : sniperModel;
        activeModel.position.z += 0.08;
        activeModel.userData.flash.material.visible = true;
        setTimeout(() => activeModel.userData.flash.material.visible = false, 50);
      }

      raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
      if (currentWeapon === 'Dagger') raycaster.far = 3.5;
      else raycaster.far = 1000;

      const hits = raycaster.intersectObjects(hitMeshes);

      if (hits.length > 0) {
        const hitPart = hits[0].object;
        const enemyGroup = hitPart.userData.parentGroup;

        if (enemyGroup && targets.includes(enemyGroup)) {
          let damage = 0;
          if (currentWeapon === 'AK-47') {
            damage = hitPart.userData.isHead ? 20.5 : 15;
            playSound('ak');
          } else if (currentWeapon === 'Sniper') {
            damage = hitPart.userData.isHead ? 150 : 50;
            playSound('sniper');
          } else if (currentWeapon === 'Dagger') {
            if (!isRightClick) {
              damage = 40;
              playSound('knife');
            } else {
              const playerDir = new THREE.Vector3();
              camera.getWorldDirection(playerDir);
              playerDir.y = 0; playerDir.normalize();

              const enemyDir = new THREE.Vector3();
              enemyGroup.getWorldDirection(enemyDir);
              enemyDir.y = 0; enemyDir.normalize();

              const dot = playerDir.dot(enemyDir);
              if (dot > 0.4) {
                damage = 150; 
                playSound('backstab');
              } else {
                damage = 40; 
                playSound('knife');
              }
            }
          }

          enemyGroup.userData.hp -= damage;

          enemyGroup.children.forEach(p => { if(p.material) p.material.color.setHex(0xffffff); });
          setTimeout(() => {
            enemyGroup.children.forEach(p => {
              if(p.material) p.material.color.setHex(p.userData.isHead ? 0xffccaa : 0xcc2222);
            });
          }, 80);

          if (enemyGroup.userData.hp <= 0) {
            scene.remove(enemyGroup);
            targets.splice(targets.indexOf(enemyGroup), 1);
            enemyGroup.children.forEach(c => {
              const idx = hitMeshes.indexOf(c);
              if (idx > -1) hitMeshes.splice(idx, 1);
            });

            score += (currentWeapon === 'Dagger' ? 250 : 100);
            document.getElementById('score').innerText = score;

            setTimeout(() => spawnEnemy(), 3000);
          }
        }
      } else if (currentWeapon === 'Dagger') {
        playSound('knife');
      }
    }

    function animate() {
      requestAnimationFrame(animate);

      if (isLocked && isFiring && currentWeapon === 'AK-47') {
        const now = Date.now();
        if (now - fireTimer > 100) {
          shootWeapon(false);
          fireTimer = now;
        }
      }

      akModel.position.z += (-0.42 - akModel.position.z) * 0.15;
      sniperModel.position.z += (-0.42 - sniperModel.position.z) * 0.15;
      daggerModel.position.z += (-0.35 - daggerModel.position.z) * 0.15;
      daggerModel.rotation.z += (0 - daggerModel.rotation.z) * 0.15;

      const speed = (currentWeapon === 'Dagger') ? 0.22 : 0.15;

      if (move.w) camera.translateZ(-speed);
      if (move.s) camera.translateZ(speed);
      if (move.a) camera.translateX(-speed);
      if (move.d) camera.translateX(speed);
      camera.position.y = 1.6;

      const time = Date.now() * 0.003;
      targets.forEach((enemy, idx) => {
        enemy.rotation.y = Math.sin(time + idx) * 0.4;
      });
      
      // 화면 렌더링 (이전에 누락되었던 필수 코드)
      renderer.render(scene, camera);
    }
    
    // 메인 루프 실행
    animate();
  };
  
  // Three.js 라이브러리를 문서에 추가하여 로드 시작
  document.head.appendChild(script);

})();
